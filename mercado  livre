### 📌 NODO 3: CODE NODE - Filtrar e Classificar

**Cole este código:**

```javascript
// ========================================
// 🧠 CÓDIGO INTELIGENTE DE FILTRAGEM
// ========================================

const items = $input.all();
const produtos = items[0].json.produtos || items[0].json.bugs || [];

console.log(`📦 Total de produtos recebidos: ${produtos.length}`);

// ========================================
// FUNÇÃO: Calcular pontuação
// ========================================
function calcularPontuacao(produto) {
  let pontos = 0;
  
  // Rating
  const rating = parseFloat(produto.avaliacao || 0);
  if (rating >= 4.8) pontos += 50;
  else if (rating >= 4.5) pontos += 35;
  else if (rating >= 4.0) pontos += 20;
  
  // Desconto
  const desconto = parseFloat((produto.desconto || "0").replace(/[^\d.,]/g, "").replace(",", "."));
  if (desconto >= 60) pontos += 40;
  else if (desconto >= 40) pontos += 30;
  else if (desconto >= 20) pontos += 15;
  
  // Avaliações
  const qtdAval = parseInt((produto.qtd_avaliacoes || "0").replace(/[^\d]/g, ""));
  if (qtdAval >= 1000) pontos += 30;
  else if (qtdAval >= 500) pontos += 20;
  else if (qtdAval >= 100) pontos += 10;
  
  // Mais vendido
  if (produto.mais_vendido) pontos += 15;
  
  return pontos;
}

// ========================================
// FUNÇÃO: Classificar qualidade
// ========================================
function classificar(pontos) {
  if (pontos >= 100) return { nivel: "PREMIUM", emoji: "💎", prioridade: 1 };
  if (pontos >= 70) return { nivel: "EXCELENTE", emoji: "🌟", prioridade: 2 };
  if (pontos >= 50) return { nivel: "BOM", emoji: "✅", prioridade: 3 };
  return { nivel: "REGULAR", emoji: "⚠️", prioridade: 4 };
}

// ========================================
// PROCESSAR PRODUTOS
// ========================================
const produtosProcessados = produtos.map(p => {
  const pontuacao = calcularPontuacao(p);
  const classificacao = classificar(pontuacao);
  
  return {
    ...p,
    pontuacao,
    nivel_qualidade: classificacao.nivel,
    emoji_qualidade: classificacao.emoji,
    prioridade: classificacao.prioridade
  };
});

// ========================================
// FILTRAR (mínimo 50 pontos)
// ========================================
const produtosFiltrados = produtosProcessados.filter(p => p.pontuacao >= 50);

// ========================================
// ORDENAR (melhor primeiro)
// ========================================
produtosFiltrados.sort((a, b) => b.pontuacao - a.pontuacao);

// ========================================
// TOP 10
// ========================================
const top10 = produtosFiltrados.slice(0, 10);

console.log(`✅ Produtos qualificados: ${produtosFiltrados.length}`);
console.log(`🏆 Top 10 selecionados`);

// ========================================
// RETORNAR CADA PRODUTO COMO UM ITEM
// ========================================
return top10.map(produto => ({
  json: produto
}));
```

